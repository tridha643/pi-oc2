{
  "name": "@pi-oc2/target-pi",
  "version": "0.1.0",
  "description": "Deterministic native Pi package generator for pi-oc2.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root . --config vitest.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --composite false --pretty false",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@pi-oc2/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "typescript-compiler": "npm:typescript@^5.9.2",
    "vitest": "4.1.11"
  }
}
