{
    "name": "pi-oc2",
    "version": "0.1.0",
    "description": "Deterministic CLI that statically analyzes Pi packages and compiles native Pi and OpenCode 2 plugin ports.",
    "type": "module",
    "sideEffects": false,
    "bin": {
        "pioc": "./dist/bin/pioc.js"
    },
    "files": [
        "dist",
        "!dist/**/*.test.*",
        "!dist/*.test.*",
        "!dist/.tsbuildinfo",
        "skills"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "pi": {
        "skills": [
            "skills/port-pi-extension-to-opencode2"
        ]
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run --root . --config vitest.config.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit --composite false --pretty false",
        "verify": "pnpm typecheck && pnpm test"
    },
    "dependencies": {
        "@earendil-works/pi-coding-agent": "0.84.3",
        "@opencode-ai/plugin": "0.0.0-dev-18204",
        "@pi-oc2/core": "workspace:*",
        "@pi-oc2/target-opencode2": "workspace:*",
        "@pi-oc2/target-pi": "workspace:*",
        "@types/node": "^24.5.2",
        "citty": "^0.2.2",
        "effect": "4.0.0-rc.111",
        "typebox": "1.3.7",
        "typescript": "7.0.2"
    },
    "devDependencies": {
        "@opencode-ai/cli": "0.0.0-dev-18204",
        "vitest": "4.1.11"
    }
}
